{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping https://unionai-core.fly.dev/metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "UNIONAI Core — Operations",
  "uid": "unionai-core-ops-v1",
  "version": 2,
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["unionai", "relay", "semantic"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Smoke Status",
      "description": "1=VERIFIED, 0=BLOCKED, -1=never run",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "VERIFIED", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "BLOCKED", "color": "red" } } },
            { "type": "value", "options": { "-1": { "text": "NO DATA", "color": "gray" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "smoke_last_ok",
          "legendFormat": "smoke"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Semantic Drift Ratio",
      "description": "0 = full semantic, 1 = all syntactic fallback",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "minVizWidth": 75,
        "showThresholdLabels": true
      },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1, "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.7 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "relay_drift_ratio",
          "legendFormat": "drift"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Relay Latency (last)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "relay_latency_ms",
          "legendFormat": "latency"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Incident Locks",
      "description": "Active incident-preserved traces (safe from prune)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "incident_locks_active",
          "legendFormat": "locked"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Provider Failovers",
      "description": "L1 cache hits + L2 sentinel promotions since restart",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "relay_provider_failover_total",
          "legendFormat": "failovers"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Prune Eligible Spans",
      "description": "Spans >7 days old, not incident-locked",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "prune_eligible_spans",
          "legendFormat": "eligible"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Relay Volume (rate)",
      "description": "relay/send + relay/route call rates",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_sent_total[2m])",
          "legendFormat": "send/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_route_total[2m])",
          "legendFormat": "route/s"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Semantic vs Syntactic Routing",
      "description": "semantic = Qdrant matched; syntactic_fallback = keyword only",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "semantic/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "syntactic/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_semantic_route_total[2m])",
          "legendFormat": "semantic/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_syntactic_route_total[2m])",
          "legendFormat": "syntactic/s"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Qdrant Activity",
      "description": "Upsert (vector writes) vs search (routing lookups)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_qdrant_upsert_total[2m])",
          "legendFormat": "upsert/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_qdrant_search_total[2m])",
          "legendFormat": "search/s"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Drift Ratio Trend",
      "description": "Track semantic drift over time (lower = more semantic)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1, "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.7 }] },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "relay_drift_ratio",
          "legendFormat": "drift_ratio"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Provider Health",
      "description": "relay_frozen=1 means operator has frozen routing",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1,
          "mappings": [{ "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "FROZEN" } } }]
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "relay_frozen",
          "legendFormat": "relay_frozen"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "memory_frozen",
          "legendFormat": "memory_frozen"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tracing Spans",
      "description": "Distributed tracing span records written to DB",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 6 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_tracing_spans_total[2m])",
          "legendFormat": "spans/s"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Errors & Timeouts",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 6 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "errors/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "timeouts/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_errors_total[2m])",
          "legendFormat": "errors/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "rate(relay_timeouts_total[2m])",
          "legendFormat": "timeouts/s"
        }
      ]
    }
  ]
}
